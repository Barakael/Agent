#!/usr/bin/env bash

# API Configuration
DEBUG=true
HOST=0.0.0.0
PORT=8001

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=medium
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4096

# Backend Configuration
BACKEND_URL=http://localhost:8000
BACKEND_API_KEY=
AI_SERVICE_API_KEY=your_backend_api_key_here
TOOL_APPROVAL_TOKEN=your_approval_token_here
ALLOWED_TOOL_ACTIONS=browser.navigate,browser.read,browser.type,browser.click,browser.search,file.read,file.write,terminal.exec
AGENT_WORKSPACE_DIR=./workspace
AGENT_MAX_TOOL_ROUNDS=10
BROWSER_HEADLESS=false
BROWSER_CHANNEL=chrome
BROWSER_TIMEOUT=45

# Service Configuration
TIMEOUT=120
MAX_CONTEXT_LENGTH=8000
