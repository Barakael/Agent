OPENAI_MAX_TOKENS=2000

# Backend Configuration
BACKEND_URL=http://localhost:8000
BACKEND_API_KEY=
AI_SERVICE_API_KEY=your_backend_api_key_here

# Service Configuration
TIMEOUT=30
MAX_CONTEXT_LENGTH=8000
