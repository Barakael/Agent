#!/usr/bin/env bash

# API Configuration
DEBUG=true
HOST=0.0.0.0
PORT=8001

# OpenAI Configuration (default — official OpenAI cloud API)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=medium
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4096
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova
OPENAI_TTS_MAX_CHARS=4096

# Self-hosted Ollama on VPS (leave empty until ready — then uncomment and set):
# OPENAI_BASE_URL=https://your-vps-host/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=qwen2.5:14b
OPENAI_BASE_URL=

# Backend Configuration
BACKEND_URL=http://localhost:8000
BACKEND_API_KEY=
AI_SERVICE_API_KEY=your_backend_api_key_here
TOOL_APPROVAL_TOKEN=your_approval_token_here
# Messaging / remote-control deploy (see deploy/messaging/README.md)
# ALLOWED_TOOL_ACTIONS=system.inspect,terminal.exec,browser.navigate,browser.read,cursor.prompt,cursor.resume
ALLOWED_TOOL_ACTIONS=browser.navigate,browser.read,browser.type,browser.click,browser.search,file.read,file.write,terminal.exec,system.inspect,media.play,media.search,cursor.prompt,cursor.resume,trading.status,trading.pause,trading.resume,trading.metrics,trading.close_all,trading.positions,trading.preflight_summary,trading.analysis_sources
AGENT_WORKSPACE_DIR=./workspace
CURSOR_TERMINALS_DIR=
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
CURSOR_PROJECT_CWD=
CURSOR_PROMPT_TIMEOUT=600
BROWSER_CHANNEL=chrome
BROWSER_TIMEOUT=45

# Local runner (VPS → desktop)
RUNNER_ENABLED=false
RUNNER_URL=http://127.0.0.1:8010
RUNNER_API_KEY=local-runner-dev-key
RUNNER_TIMEOUT=630

# Trading engine supervision
TRADING_ENGINE_URL=http://localhost:8002
TRADING_SERVICE_API_KEY=your_trading_api_key_here

# Service Configuration
TIMEOUT=120
MAX_CONTEXT_LENGTH=8000
