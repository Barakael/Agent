[Unit]
Description=Wayda AI Agent
After=network.target

[Service]
Type=simple
User=wayda
WorkingDirectory=/opt/wayda/ai-agent
EnvironmentFile=/opt/wayda/ai-agent/.env
ExecStart=/opt/wayda/ai-agent/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
