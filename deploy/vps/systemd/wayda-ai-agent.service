[Unit]
Description=Wayda AI Agent
After=network.target

[Service]
Type=simple
User=wayda
Group=wayda
WorkingDirectory=/etc/bin/agent/ai-agent
EnvironmentFile=/etc/bin/agent/ai-agent/.env
ExecStart=/etc/bin/agent/ai-agent/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
