# Trading Engine
DEBUG=true
HOST=0.0.0.0
PORT=8002
# Internal API key — Laravel/ai-agent use this to call trading-engine (NOT your Deriv PAT)
TRADING_SERVICE_API_KEY=wayda-trading-secret-key

# Deriv — developers.deriv.com → Dashboard → API tokens (select DEMO account)
# PAT format: pat_xxxxxxxx...  (separate from TRADING_SERVICE_API_KEY)
DERIV_API_TOKEN=paste_your_demo_pat_here

# App ID from developers Dashboard → the SAME application that issued the PAT
# Must be that app's Application ID (Invalid application = wrong UUID / Client ID)
DERIV_APP_ID=your_app_id_here
DERIV_CLIENT_ID=your_client_id_here
# Legacy WebSocket needs numeric app id — 1089 works for testing / classic tokens
DERIV_WS_APP_ID=1089
# Optional: demo account id from REST list accounts (for OTP WebSocket)
DERIV_ACCOUNT_ID=
DERIV_DEMO_LOGINID=
TRADING_MODE=log_only

# Refuse live Deriv account unless TRADING_MODE=live
DERIV_REQUIRE_DEMO=true

TRADING_PAIRS=frxEURUSD,frxGBPUSD,frxUSDJPY,frxAUDUSD
CANDLE_TIMEFRAME_MINUTES=5
CANDLE_BUFFER_SIZE=200

RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9

# Strategy Manager (Number Engine → confidence gate)
STRATEGY_CONFIDENCE_THRESHOLD=70
ATR_SL_MULTIPLIER=1.5
DEFAULT_RR_RATIO=2.0

RISK_PERCENT_PER_TRADE=1.5
DAILY_DRAWDOWN_LIMIT_PERCENT=4.0
MAX_DAILY_PROFIT_PERCENT=8.0
MAX_TRADES_PER_DAY=20
DEFAULT_SL_PIPS=15
DEFAULT_TP_PIPS=30

SESSION_OPEN_HOUR_UTC=7
SESSION_CLOSE_HOUR_UTC=21
SESSION_CLOSE_MINUTE_UTC=0

DATABASE_URL=sqlite:///./trading_journal.db

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

BACKEND_URL=http://localhost:8000
BACKEND_API_KEY=

# Always-on Number Engine (Deriv → NumberEngine → StrategyManager → RiskGate)
# Set AUTO_START_BOT=true on VPS so systemd boot starts the Deriv loop
AUTO_START_BOT=false
# When true: skip ATAE evaluate_open / analysis_armed; RiskGate is the hard gate
NUMBER_ENGINE_EXECUTION=true

# ATAE — optional when NUMBER_ENGINE_EXECUTION=true
ANALYSIS_REQUIRE_PREFLIGHT=false
ANALYSIS_SCENARIO_WINDOW_BARS=50
ANALYSIS_MIN_SCENARIO_WIN_RATE=0.45
ANALYSIS_PREFLIGHT_BACKTEST_BARS=500
# Optional: Laravel analysis-decision endpoint (requires auth token if set)
ANALYSIS_AI_DECISION_URL=

# Daily plan clamps (automation)
PLAN_RISK_PERCENT_MAX=2.0
PLAN_MAX_STAKE_USD_CEILING=50
