# Trading Engine
DEBUG=true
HOST=0.0.0.0
PORT=8002
TRADING_SERVICE_API_KEY=your_trading_api_key_here

# Deriv (demo account)
DERIV_APP_ID=1089
DERIV_API_TOKEN=

# Mode: log_only | demo | live
TRADING_MODE=log_only

TRADING_PAIRS=frxEURUSD,frxGBPUSD,frxUSDJPY,frxAUDUSD
CANDLE_TIMEFRAME_MINUTES=5
CANDLE_BUFFER_SIZE=200

# Indicators
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9

# Risk (moderate)
RISK_PERCENT_PER_TRADE=1.5
DAILY_DRAWDOWN_LIMIT_PERCENT=4.0
DEFAULT_SL_PIPS=15
DEFAULT_TP_PIPS=30

# Session UTC
SESSION_OPEN_HOUR_UTC=7
SESSION_CLOSE_HOUR_UTC=21
SESSION_CLOSE_MINUTE_UTC=0

DATABASE_URL=sqlite:///./trading_journal.db

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

BACKEND_URL=http://localhost:8000
BACKEND_API_KEY=
