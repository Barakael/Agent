# Trading Engine
DEBUG=true
HOST=0.0.0.0
PORT=8002
# Internal API key — Laravel/ai-agent use this to call trading-engine (NOT your Deriv PAT)
TRADING_SERVICE_API_KEY=wayda-trading-secret-key

# Deriv — developers.deriv.com → Dashboard → API tokens (select DEMO account)
# PAT format: pat_xxxxxxxx...  (separate from TRADING_SERVICE_API_KEY)
DERIV_API_TOKEN=paste_your_demo_pat_here

# App ID from developers Dashboard → the SAME application that issued the PAT
# Must be that app's Application ID (Invalid application = wrong UUID / Client ID)
DERIV_APP_ID=your_app_id_here
DERIV_CLIENT_ID=your_client_id_here
# Legacy WebSocket needs numeric app id — 1089 works for testing / classic tokens
DERIV_WS_APP_ID=1089
# Optional: demo account id from REST list accounts (for OTP WebSocket)
DERIV_ACCOUNT_ID=
DERIV_DEMO_LOGINID=
TRADING_MODE=log_only

# Refuse live Deriv account unless TRADING_MODE=live
DERIV_REQUIRE_DEMO=true

# Forex majors only. Their daily ATR (0.4-0.7% of price) fits inside the 1.0%
# of room a x100 multiplier allows. Gold (2.2%) and the synthetics (4%) do not,
# so a chart stop cannot be encoded on them — see scripts/instrument_fit.py.
# frx* close Fri 20:55 to Sun 21:05 UTC; R_* / 1HZ* run 24/7.
TRADING_PAIRS=frxEURUSD,frxGBPUSD,frxUSDJPY,frxAUDUSD,frxUSDCAD
CANDLE_TIMEFRAME_MINUTES=5
# Need ~288 for 24h regime; 400 so 1h confirm (~24–30 hourly bars) is reachable
CANDLE_BUFFER_SIZE=400

# Bias pipeline: 24h regime → 6h bias → 1h entry (5m feed only)
BIAS_PIPELINE=true
BIAS_PIPELINE_SYMBOLS=R_50
BIAS_REGIME_HOURS=24
BIAS_LOOKBACK_HOURS=6
BIAS_ENTRY_TF_MINUTES=60
BIAS_DEADZONE_ATR_FRAC=0.3
BIAS_MAX_OPEN_THESIS=1
BIAS_SL_ATR_MULT=1.0

# Independent horizon reviews (advisory stance; separate cadences)
# Mid = 4 or 6h; 8h = longer review. Neither places orders by itself.
REVIEW_HORIZON_ENABLED=true
REVIEW_MID_HOURS=6
REVIEW_8H_HOURS=8
# Empty = all active pairs
REVIEW_HORIZON_SYMBOLS=

# Rolling 8h “enter now” projection (structure+ATR) + soft gate vs bias
PROJECTION_ENABLED=true
PROJECTION_LOOKBACK_HOURS=8
PROJECTION_FORWARD_HOURS=6
PROJECTION_ATR_MULT=1.0
PROJECTION_SOFT_GATE=true

# Multiplier liquidates at 1/multiplier, so it caps the widest encodable stop.
# Deriv offers 100/200/300/500/800 on forex: x100 gives 1.0% of room, enough for
# a one-ATR stop on the majors. Validated against Deriv's list at startup.
DERIV_MULTIPLIER=100
MULTIPLIER_STOP_SAFETY=1.25
REJECT_UNENCODABLE_STOP=true

RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9

# Strategy Manager (Number Engine → confidence gate)
STRATEGY_CONFIDENCE_THRESHOLD=94
# Comma list; empty = all patterns. Example: trend_following
STRATEGY_ALLOWLIST=trend_following
# Barred regardless of allowlist — 0/12 and 0/5 in demo with no self-exit win
STRATEGY_DENYLIST=range_trading,momentum
ATR_SL_MULTIPLIER=1.5
DEFAULT_RR_RATIO=2.0

# Entry patterns allowed to fire. Breakouts excluded until replay measures them.
PRICE_ACTION_PATTERNS=pin,engulfing
BIAS_CONFIRM_TYPES=pin,engulfing

# Demo: fixed stake. Live (TRADING_MODE=live): balance × RISK_PERCENT_PER_TRADE
RISK_PERCENT_PER_TRADE=1.5
DEMO_FIXED_STAKE_USD=100
DAILY_DRAWDOWN_LIMIT_PERCENT=4.0
MAX_DAILY_PROFIT_PERCENT=8.0
# Daily open cap. 0 = unlimited (that is how 22 fills hit one 8h window)
MAX_TRADES_PER_DAY=4
# Concurrent open contracts — one 6h thesis at a time, no stacking
MAX_OPEN_POSITIONS=1
DEFAULT_SL_PIPS=15
DEFAULT_TP_PIPS=30

SESSION_ENFORCE=false
SESSION_OPEN_HOUR_UTC=7
SESSION_CLOSE_HOUR_UTC=21
SESSION_CLOSE_MINUTE_UTC=0

DATABASE_URL=sqlite:///./trading_journal.db

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

BACKEND_URL=http://localhost:8000
BACKEND_API_KEY=

# Always-on Number Engine (Deriv → NumberEngine → StrategyManager → RiskGate)
# Set AUTO_START_BOT=true on VPS so systemd boot starts the Deriv loop
AUTO_START_BOT=false
# When true: skip ATAE evaluate_open / analysis_armed; RiskGate is the hard gate
NUMBER_ENGINE_EXECUTION=true

# ATAE — optional when NUMBER_ENGINE_EXECUTION=true
ANALYSIS_REQUIRE_PREFLIGHT=false
ANALYSIS_SCENARIO_WINDOW_BARS=50
ANALYSIS_MIN_SCENARIO_WIN_RATE=0.45
ANALYSIS_PREFLIGHT_BACKTEST_BARS=500
# Optional: Laravel analysis-decision endpoint (requires auth token if set)
ANALYSIS_AI_DECISION_URL=

# Daily plan clamps (automation)
PLAN_RISK_PERCENT_MAX=2.0
PLAN_MAX_STAKE_USD_CEILING=100
